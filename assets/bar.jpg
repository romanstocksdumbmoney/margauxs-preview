<noscript><style>body:not(.content-full-screen) .wpex-vc-row-stretched[data-vc-full-width-init="false"]{visibility:visible;}</style></noscript><style id="wp-custom-css">
h1.Welcome{font-weight:200;font-size:2.2em;color:#e29435;line-height:1.2em;text-transform:uppercase;margin-top:30px;}  /* Menu Styling */.xwgj-1 .imp-wrapper-matchcenter2 .imp-name{font-size:1.4em!important}.xwgj-1 .imp-wrapper-matchcenter2 .imp-name.imp-description{font-size:1.1em!important;font-family:'montserrat',sans serif!important}.xwgj-1imp-name{font-size:180%!important}ul#kcr_st_tweets_holder li a.kcr_st_link,a.twitter-link{display:none!important}ul#kcr_st_tweets_holder li{margin:30px 0px!important;text-align:center!important;color:#303030!important;font-size:110%;font-family:'montserrat',sans serif!important}#kcr_st_tweets_holder{margin:0px!important}/* Fix menus menu */.theme-button.minimal-border{color:#fff;}.theme-button.minimal-border.active,.theme-button.minimal-border:hover{color:#000;}/* Events */#tribe-events-bar{display:none}.tribe-events-list-separator-month span{background-color:#050d11;font-weight:400;padding:0 3%;}.single-tribe_events .tribe-events-event-meta{background-color:#050d11;font-size:1.3em;}.tribe-events-start-date-label,.tribe-events-start-time-label,.single-tribe_events #tribe-events-content .tribe-events-event-meta dt,.single-tribe_events #tribe-events-content .tribe-events-event-meta dd.tribe-venue{color:#fff!important}.tribe-event-schedule-details{font-size:1.3em;font-family:'montserrat';}.tribe-events-page-title{color:#fff!important}.single-page-header h1{color:#e29435!important;}.css-events-list table.events-table th.event-time{width:200px;}table.events-table{font-weight:bold!important}/* Button Styles */.vc_general.vc_btn3{font-weight:bold;font-family:'montserrat',sans serif!important}.vc_btn3-style-outline-custom{font-weight:bold;font-family:'montserrat',sans serif!important}.menu-btn2 a{color:#e29435!important;border:3px solid #e29435!important;padding:0px 10px;display:block;text-transform:uppercase;margin:0px 10px;}.menu-btn2 a:hover{color:#050d11!important;background-color:#e29435!important;transition:.25s;}.menu-btn a{color:#fff!important;border:3px solid #fff;padding:0px 10px;display:block;text-transform:uppercase;margin:0px 10px;}.menu-btn a:hover{color:#050d11!important;background-color:#fff!important;transition:.25s;}  .theme-button,button{border-radius:0px!important;font-size:1.2em!important;font-weight:600!important;}/* Typography Styles */.thin-orange{color:#e29435!important;font-weight:300!important;}.thin-white{color:#ffffff!important;font-weight:300!important;}.bold-white{color:#fff!important;font-weight:bold}.centered-page-header .page-subheading{font-weight:400;color:#faa339;font-size:1.6em;text-shadow:0px 0px 6px rgba(0,0,0,0.55);font-family:'Montserrat',sans-serif;text-transform:uppercase;}.social-share-title{color:#e29435!important}sup{font-size:70%}/* Header Styles */#site-logo{width:400px;}#site-logo img{height:75px;}/* Navigation Styles */.navbar-style-one .dropdown-menu>li.menu-item>a{line-height:45px!important}#site-header.overlay-header.white-style.dyn-styles #site-navigation .dropdown-menu>li>a:hover{opacity:1;color:#050d11!important}.full-screen-overlay-nav.black li a{opacity:1}/* Home Page Styles */#hero h2{font-size:3em;line-height:1em;/*text-shadow:0px 0px 5px #000000;*/}/* Main Body Styles */#content li{margin-bottom:15px}hr{color:#e29435!important;border:1px solid rgba(226,148,53,.5)}/*Local Purveyor Styles*/#purveyor-logos p{color:#303030;}/*Title Bar Styles*/.page-header.background-image-page-header .page-header-title{font-weight:bold;color:#ffffff;font-size:2.5em;}.page-header.background-image-page-header .page-subheading{font-weight:400;color:#faa339;font-size:1.6em;text-shadow:0px 0px 6px rgba(0,0,0,0.55);font-family:'Montserrat',sans-serif;}/*Testimonial Stles*/.testimonial-entry-author{color:#ccc!important}.testimonial-entry-content{background:#333!important}.testimonial-entry-content p{color:#959595!important}.testimonial-caret{border-top:12px solid #333}.testimonial-entry-title{font-weight:500!important;font-size:1.5em;color:#e29435!important;line-height:1.3em;text-transform:uppercase;}/*Staff Styles*/#staff-grid img{border-radius:0%;}.staff-title{font-weight:400;font-size:.8em;font-style:italic;}.staff-entry-title.entry-title{font-size:18px;line-height:23px;}.staff-single-media-img{width:auto;height:340px;}#staff-single-media{float:left;margin-right:30px;}#staff-single-header{display:inline-table;}#staff-single-title,#staff-single-position{color:#117dbb;}#staff-page img{border-radius:50%;}.staff-entry-details{text-align:center;margin-top:-10px;}/*.staff-entry-media img{border-radius:50%;}*//*Blog Styles*/.single-post-title entry-title{color:#ffffff;}.theme-heading social-share-title{color:#ffffff;}/*CTA Bar Styles*/#cta-bar-text h2{font-size:2.5em;}/* Form Styles */.label-above .nf-field-label{margin-bottom:0px;margin-top:10px;}.rtb-booking-form legend{padding:0!important;text-transform:uppercase;color:#fff;font-weight:bold}#rtb-party{color:#474747}input{border-radius:0px!important}select{color:#717171!important}/* Footer Styles *//* Misc Styles */.ot-powered-by{display:none!important}.ot-dtp-picker{background:#050d11!important}.ot-title{color:#fff!important}#sgpb-popup-dialog-main-div-wrapper p{color:#000!important}#reservations .vcex-icon-box-css-wrap{margin:0px}.vc_tta-title-text{font-weight:700;text-transform:uppercase;}.ui-widget-header{border:1px solid #000 !important;background:#e29435 !important;color:#ffffff;font-weight:bold;}.wpcf7-form-control-wrap option,.wpcf7-form-control-wrap select{color:#000 !important;}#blackbgrd{background-color:#000 !important;}/* 08-10-2020 */.wpcf7 .wpcf7-not-valid{border:2px solid #f00;}/* 08-10-2020 *//* Responsive Styles */@media screen and (max-width:1224px){}@media screen and (max-width:1149px){#hero h2{font-size:2.3em;}}@media screen and (max-width:1090px){.top-bar-menu{display:none}}@media screen and (max-width:980px){}@media screen and (max-width:767px){.footer-callout-content{text-align:center;}.top-bar-right{padding-top:0px;}#staff-single-media{float:none;margin:30px;}#hero h2{font-size:1.5em;}}@media screen and (max-width:480px){#hero-mobile h2{font-size:2em !important;font-weight:600!important;line-height:1em;}#hero-mobile .thin-orange{font-weight:500!important;}.phone{font-size:125%}}@media screen and (max-width:320px){}/* Instagram Profile Embed on Home Page Styles */iframe#instagram-embed-0{margin:auto !important;}/* Hide old Instagram feed on homepage */.hideme{display:none;}
</style>
<noscript><style> .wpb_animate_when_almost_visible { opacity: 1; }</style></noscript><style data-type="wpex-css" id="wpex-css">/*TYPOGRAPHY*/:root{--wpex-body-font-family:'Open Sans',sans-serif;--wpex-body-font-weight:400;--wpex-body-font-size:16px;--wpex-body-color:#d8d8d8;}:root{--wpex-heading-font-family:Montserrat;}:root{--wpex-btn-font-family:Montserrat;--wpex-btn-font-weight:700;--wpex-btn-text-transform:uppercase;}#top-bar-content{font-family:Montserrat;font-weight:700;font-size:.9em;text-transform:uppercase;}.main-navigation-ul .link-inner{font-family:Montserrat;font-weight:700;font-size:1.2em;text-transform:uppercase;}.wpex-mobile-menu,#sidr-main{font-family:Montserrat;text-transform:uppercase;}.page-header .page-header-title{font-family:Montserrat;font-weight:700;font-size:2.5em;text-transform:uppercase;}.blog-entry-title.entry-title,.blog-entry-title.entry-title a,.blog-entry-title.entry-title a:hover{color:#e29435;}body.single-post .single-post-title{color:#e29435;text-transform:uppercase;}h1,.wpex-h1{color:#e29435;}h2,.wpex-h2{font-weight:200;font-size:2.2em;color:#e29435;line-height:1.2em;text-transform:uppercase;}h3,.wpex-h3{color:#ffffff;text-transform:uppercase;}@media(max-width:479px){h2,.wpex-h2{font-size:1.8em;}}/*ADVANCED STYLING CSS*/#site-logo .logo-img{height:75px;width:auto;}/*CUSTOMIZER STYLING*/:root{--wpex-bg-color:#050d11;--wpex-accent:#e29435;--wpex-accent-alt:#e29435;--wpex-accent-alt:#cc852e;--wpex-site-header-shrink-start-height:100px;--wpex-site-header-shrink-end-height:60px;--wpex-vc-column-inner-margin-bottom:40px;}.site-boxed{--wpex-bg-color:#050d11;}::selection{background:#e29435;color:#ffffff;}::-moz-selection{background:#e29435;color:#ffffff;}.page-header{margin-block-end:50px;}.page-header.wpex-supports-mods{background-color:#262626;border-top-color:#262626;border-bottom-color:#262626;}.page-header.wpex-supports-mods .page-header-title{color:#ffffff;}:root,.site-boxed.wpex-responsive #wrap{--wpex-container-width:1580px;}#toggle-bar-wrap{--wpex-surface-1:#000000;background:#000000;color:#ffffff;--wpex-text-2:#ffffff;--wpex-text-3:#ffffff;--wpex-text-4:#ffffff;}#top-bar-wrap{background-color:#e29435;border-color:#e29435;}.wpex-top-bar-sticky{background-color:#e29435;}#top-bar{color:#171717;--wpex-text-2:#171717;--wpex-text-3:#171717;--wpex-text-4:#171717;--wpex-link-color:#171717;--wpex-hover-link-color:#171717;padding-block-start:1px;padding-block-end:0px;}#top-bar-social a.wpex-social-btn-no-style{color:#ffffff;}#top-bar-social a.wpex-social-btn-no-style:hover{color:#3a3a3a;}.header-padding{padding-block-start:5px;padding-block-end:5px;}#site-header{--wpex-site-header-bg-color:#050d11;}.logo-padding{padding-block-start:0px;padding-block-end:0px;}.wpex-sticky-header-holder.is-sticky #site-header{opacity:0.9;}#site-navigation-wrap{--wpex-hover-main-nav-link-color:#e29435;--wpex-active-main-nav-link-color:#e29435;}#mobile-menu,#mobile-icons-menu{--wpex-link-color:#ffffff;--wpex-hover-link-color:#ffffff;--wpex-hover-link-color:#ffffff;}#sidebar .widget-title{color:#e29435;}.blog-entry{--wpex-entry-left-thumbnail-media-width:30%;--wpex-entry-left-thumbnail-content-width:65%;}#footer-bottom{background-color:#020202;color:#ffffff;--wpex-text-2:#ffffff;--wpex-text-3:#ffffff;--wpex-text-4:#ffffff;--wpex-link-color:#ffffff;--wpex-hover-link-color:#ffffff;}@media only screen and (max-width:767px){#site-logo .logo-img{max-width:240px;}}</style><noscript><style id="rocket-lazyload-nojs-css">.rll-youtube-player, [data-lazy-src]{display:none !important;}</style></noscript>	

