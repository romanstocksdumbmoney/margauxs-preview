<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Organization",    
  "name": "Margaux's Restaurant",
  "url": "https://margauxsrestaurant.com/",
  "logo": "https://margauxsrestaurant.com/wp-content/uploads/2019/07/Margauxs-Restaurant-Raleigh-NC.svg",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "ratingCount": "394"
   },
  "review": [ 
    {
    "@type": "Review",
    "author": {
        "@type": "Person",
        "name": "Brittany Waddell"
      },
    "datePublished": "2020-09-18",
    "reviewBody": "What a great place for a birthday dinner! I really loved the selections and the scallops were Soo good!!!",
    "reviewRating": {
      "@type": "Rating",
      "bestRating": "5",
      "ratingValue": "5",
      "worstRating": "1"
    }
    },
    {
    "@type": "Review",
    "author": {
        "@type": "Person",
        "name": "Uwanzi I"
      },
    "datePublished": "2020-08-18",
    "reviewBody": "My boyfriend took me here for my birthday. My first impression was that staff was very welcoming and friendly. The restaurant was beautiful and clean. The atmosphere was very inviting and warm. My waitress Heather was very friendly and interactive. The food prices were reasonable in my opinion and they also offered 3 course deals between 5-6:30pm I believe. The bread was so delicious. Yummilicious!! The food we ordered was so delicious. I was stuffed by the end of the dinner. Thank you for feeding us and providing a friendly and inviting atmosphere to the people of Raleigh.",
    "reviewRating": {
      "@type": "Rating",
      "bestRating": "5",
      "ratingValue": "5",
      "worstRating": "1"
    }
    }
  ]
}
</script> 
